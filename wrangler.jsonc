{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poss",
  "main": "worker.js",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_NAME": "Hisabi Bondhu"
  }
}
